{
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["https://esm.sh/@supabase/functions-js@2.4.1/src/edge-runtime.d.ts"]
  },
  "include": ["**/*.ts"]
}
